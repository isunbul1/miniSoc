# MiniSOC Backend - Environment Variables
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=MiniSOC Backend
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./minisoc.db

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Threat Detection Engine Settings
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
SUCCESSFUL_LOGIN_AFTER_BF_WINDOW_MINUTES=10
PORT_SCAN_PORT_THRESHOLD=10
PORT_SCAN_WINDOW_MINUTES=2
